# Trading Dashboard Configuration

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Trading Symbols (comma-separated)
SYMBOLS=BTC-USD,^NSEI

# Update Intervals
UPDATE_INTERVAL_MINUTES=1
AUTO_TRADER_INTERVAL_SECONDS=30

# Notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATION_METHOD=telegram

# Telegram Configuration
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Ntfy Configuration
NTFY_ENDPOINT=https://ntfy.sh/your-topic

# Logging
ENABLE_LOGS=true
LOG_LEVEL=INFO
LOG_FILE=auto_trader.log
MAX_LOG_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Trading Configuration
MAX_OPEN_POSITIONS=3
INITIAL_SL_PERCENT=1
TRAILING_SL_PERCENT=0.5
PROFIT_TARGET_PERCENT=2
MIN_SIGNAL_GAP_SECONDS=60

# Performance Settings
MAX_CANDLES_IN_MEMORY=200
PARALLEL_SYMBOL_PROCESSING=true
RATE_LIMIT_DELAY_MS=200

# Timezone
TIMEZONE=Asia/Kolkata
